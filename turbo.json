{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", ".output/**", ".expo/**"],
      "env": [
        "VITE_API_URL",
        "VITE_PUBLIC_POSTHOG_HOST",
        "VITE_PUBLIC_POSTHOG_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    }
  }
}
