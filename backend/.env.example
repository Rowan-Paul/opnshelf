# --- AT Protocol PDS ---
# Point this at YOUR Tranquil PDS (not the reference PDS) so opnshelf controls
# signup. Tranquil should run with invite_code_required = true.
PDS_URL="https://opnshelf.xyz"

# The handle domain Tranquil serves accounts on. A username "jane" becomes
# "jane.opnshelf.xyz". Must be one of the PDS's user_handle_domains.
PDS_HANDLE_DOMAIN="opnshelf.social"

# Admin account on the Tranquil PDS (a normal account with is_admin = true).
# opnshelf logs in as this account to mint single-use invite codes.
PDS_ADMIN_IDENTIFIER="admin.opnshelf.xyz"
PDS_ADMIN_PASSWORD="change-me"

# --- "Continue with Google" signup ---
# Must be the SAME Google OAuth client the PDS uses (its SSO_GOOGLE_* values).
# The PDS checks the id_token's audience against its own client id, so a
# separate opnshelf client would be rejected. Add
# "<BACKEND_PUBLIC_URL>/auth/google/callback" as a second redirect URI on it.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anti-spam: Cloudflare Turnstile ---
# Server-side secret used to verify the captcha token from the signup form.
# Leave empty to disable captcha verification (local dev only — never in production).
TURNSTILE_SECRET_KEY=""

# --- Email: Cloudflare Email Sending ---
# Used to send the feedback notification email via Cloudflare's REST API.
# Token needs the "Email Sending: Edit" permission; account id is not secret.
# Leave empty to disable feedback emails (they are logged-and-skipped).
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Where feedback submissions are emailed to (an admin inbox).
FEEDBACK_NOTIFICATION_EMAIL=""

# --- Existing config (for reference) ---
# DATABASE_URL="postgresql://..."
# FRONTEND_URL="http://127.0.0.1:3000"
# BACKEND_PUBLIC_URL="http://127.0.0.1:3001"
# NODE_ENV="development"

# --- AT Protocol ingestion ---
# Must match the root TAB_ADMIN_PASSWORD used by docker-compose.yml.
TAB_URL="http://localhost:2480"
TAB_ADMIN_PASSWORD="y29d6b572f17af0f150cd4b480bec85cf"
