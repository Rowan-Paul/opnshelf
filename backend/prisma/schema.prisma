generator client {
  provider   = "prisma-client"
  output     = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  did         String   @id
  handle      String   @unique
  displayName String?
  avatar      String?
  profileRkey String?
  profileUri  String?
  profileCid  String?
  profileDisplayName String?
  profileAvatarCid String?
  profileAvatarMimeType String?
  profileUpdatedAt DateTime?
  timezone    String   @default("UTC")
  timeFormat  String   @default("24h")
  onboardingCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  trackedMovies TrackedMovie[]
  trackedEpisodes TrackedEpisode[]
  lists        List[]
  notes        Note[]
  reviews      Review[]
  feedback     Feedback[]
  following    Follow[] @relation("UserFollowing")
  followers    Follow[] @relation("UserFollowers")
  
  @@index([handle])
  @@index([profileAvatarCid])
}

model Follow {
  followerDid  String
  followingDid String
  rkey         String?
  uri          String?
  cid          String?
  createdAt    DateTime @default(now())

  follower     User @relation("UserFollowing", fields: [followerDid], references: [did], onDelete: Cascade)
  following    User @relation("UserFollowers", fields: [followingDid], references: [did], onDelete: Cascade)

  @@id([followerDid, followingDid])
  @@index([followerDid, createdAt])
  @@index([followingDid, createdAt])
  @@index([followerDid, rkey])
}

enum MediaType {
  movie
  show
  season
  episode
}


// OAuth session storage for @atproto/oauth-client-node sessionStore
// No FK to User because the OAuth library stores session before we create the User
// Cookie stores opaque id (not DID) for session lookup
model AuthSession {
  id          String   @id @default(cuid())
  userDid     String   @unique
  sessionData String   // JSON-serialized session from the library
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([updatedAt])
}

model AuthState {
  key       String   @id
  stateData String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([expiresAt])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  userDid     String
  status      String    @default("queued")
  data        Json      @default("{}")
  nextRunAt   DateTime  @default(now())
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status, nextRunAt])
  @@index([userDid, type])
}

model Movie {
  movieId      String   @id
  title        String
  posterPath   String?
  backdropPath String?
  releaseYear  Int?
  releaseDate  DateTime?
  overview     String?
  colors       Json?    // { primary, secondary, accent, muted }

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackedBy    TrackedMovie[]
  listItems    ListItem[]

  @@index([title])
}

model Show {
  showId        String   @id
  title         String
  posterPath    String?
  backdropPath  String?
  firstAirYear  Int?
  firstAirDate  DateTime?
  overview      String?
  colors        Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trackedBy     TrackedEpisode[]
  listItems     ListItem[]
  seasons       Season[]

  @@index([title])
}

model Season {
  id            String    @id @default(cuid())
  tmdbId        Int       @unique
  showId        String
  show          Show      @relation(fields: [showId], references: [showId], onDelete: Cascade)
  seasonNumber  Int
  name          String
  posterPath    String?
  airDate       DateTime?
  episodeCount  Int?

  episodes      Episode[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([showId, seasonNumber])
  @@index([showId])
}

model Episode {
  id             String    @id @default(cuid())
  tmdbId         Int       @unique
  seasonId       String
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  showId         String
  episodeNumber  Int
  seasonNumber   Int
  name           String
  airDate        DateTime?
  overview       String?
  stillPath      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([showId, seasonNumber, episodeNumber])
  @@index([seasonId])
  @@index([showId])
  @@index([airDate])
}

model TrackedMovie {
  id          String   @id @default(cuid())
  rkey        String   @unique
  uri         String
  cid         String
  
  userDid     String
  user        User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  
  status      String   @default("watched")
  watchedDate DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userDid])
  @@index([movieId])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}

model TrackedEpisode {
  id            String   @id @default(cuid())
  rkey          String   @unique
  uri           String
  cid           String

  userDid       String
  user          User     @relation(fields: [userDid], references: [did], onDelete: Cascade)

  showId        String
  show          Show     @relation(fields: [showId], references: [showId], onDelete: Cascade)

  seasonNumber  Int
  episodeNumber Int
  status        String   @default("watched")
  watchedDate   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userDid])
  @@index([showId])
  @@index([seasonNumber])
  @@index([episodeNumber])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}

model List {
  id          String   @id @default(cuid())
  rkey        String   @unique
  uri         String
  cid         String?
  
  userDid     String
  user        User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  
  name        String
  description String?
  slug        String
  isDefault   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       ListItem[]
  
  @@unique([userDid, slug])
  @@index([userDid])
  @@index([isDefault])
}

model ListItem {
  id            String    @id @default(cuid())
  rkey          String    @unique
  uri           String
  cid           String?

  listId        String
  list          List      @relation(fields: [listId], references: [id], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int       @default(0)
  episodeNumber Int       @default(0)

  movieId       String?
  movie         Movie?    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  showId        String?
  show          Show?     @relation(fields: [showId], references: [showId], onDelete: Cascade)

  notes         String?
  position      Int       @default(0)

  createdAt     DateTime  @default(now())

  @@unique([listId, mediaType, mediaId, seasonNumber, episodeNumber])
  @@index([listId])
  @@index([mediaType, mediaId])
}

model Note {
  id            String   @id @default(cuid())
  rkey          String   @unique
  uri           String
  cid           String

  userDid       String
  user          User     @relation(fields: [userDid], references: [did], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int      @default(0)
  episodeNumber Int      @default(0)

  content       String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userDid, mediaType, mediaId, seasonNumber, episodeNumber])
  @@index([userDid])
  @@index([mediaType, mediaId])
}

model Review {
  id            String   @id @default(cuid())
  rkey          String   @unique
  uri           String
  cid           String

  userDid       String
  user          User     @relation(fields: [userDid], references: [did], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int      @default(0)
  episodeNumber Int      @default(0)

  rating        Int
  content       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userDid, mediaType, mediaId, seasonNumber, episodeNumber])
  @@index([userDid])
  @@index([mediaType, mediaId])
  @@index([rating])
}

model Feedback {
  id        String   @id @default(cuid())
  userDid   String
  user      User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  category  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userDid])
  @@index([createdAt])
}
