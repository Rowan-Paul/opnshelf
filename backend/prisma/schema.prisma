generator client {
  provider   = "prisma-client"
  output     = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  did         String   @id
  handle      String   @unique
  displayName String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  trackedMovies TrackedMovie[]
  
  @@index([handle])
}

// OAuth session storage for @atproto/oauth-client-node sessionStore
// No FK to User because the OAuth library stores session before we create the User
model AuthSession {
  userDid     String   @id
  sessionData String   // JSON-serialized session from the library
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([updatedAt])
}

model AuthState {
  key       String   @id
  stateData String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([expiresAt])
}

model Movie {
  movieId      String   @id
  title        String
  posterPath   String?
  backdropPath String?
  releaseYear  Int?
  releaseDate  DateTime?
  overview     String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  trackedBy    TrackedMovie[]
  
  @@index([title])
}

model TrackedMovie {
  id          String   @id @default(cuid())
  rkey        String
  uri         String   @unique
  cid         String
  
  userDid     String
  user        User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  
  status      String   @default("watched")
  watchedDate DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userDid])
  @@index([movieId])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}
