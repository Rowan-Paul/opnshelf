generator client {
  provider   = "prisma-client"
  output     = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  did         String   @id
  handle      String   @unique
  displayName String?
  avatar      String?
  timezone    String   @default("UTC")
  timeFormat  String   @default("24h")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  trackedMovies TrackedMovie[]
  lists        MovieList[]
  
  @@index([handle])
}

// OAuth session storage for @atproto/oauth-client-node sessionStore
// No FK to User because the OAuth library stores session before we create the User
// Cookie stores opaque id (not DID) for session lookup
model AuthSession {
  id          String   @id @default(cuid())
  userDid     String   @unique
  sessionData String   // JSON-serialized session from the library
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([updatedAt])
}

model AuthState {
  key       String   @id
  stateData String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([expiresAt])
}

model Movie {
  movieId      String   @id
  title        String
  posterPath   String?
  backdropPath String?
  releaseYear  Int?
  releaseDate  DateTime?
  overview     String?
  colors       Json?    // { primary, secondary, accent, muted }

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trackedBy    TrackedMovie[]
  listItems    MovieListItem[]

  @@index([title])
}

model TrackedMovie {
  id          String   @id @default(cuid())
  rkey        String   @unique
  uri         String
  cid         String
  
  userDid     String
  user        User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  
  status      String   @default("watched")
  watchedDate DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userDid])
  @@index([movieId])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}

model MovieList {
  id          String   @id @default(cuid())
  rkey        String   @unique
  uri         String
  cid         String?
  
  userDid     String
  user        User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  
  name        String
  description String?
  slug        String
  isDefault   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       MovieListItem[]
  
  @@unique([userDid, slug])
  @@index([userDid])
  @@index([isDefault])
}

model MovieListItem {
  id        String   @id @default(cuid())
  rkey      String   @unique
  uri       String
  cid       String?
  
  listId    String
  list      MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  
  notes     String?
  position  Int      @default(0)
  
  createdAt DateTime @default(now())
  
  @@unique([listId, movieId])
  @@index([listId])
  @@index([movieId])
}
