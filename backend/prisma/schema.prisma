generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  did                     String           @id
  handle                  String           @unique
  displayName             String?
  avatar                  String?
  profileRkey             String?
  profileUri              String?
  profileCid              String?
  profileDisplayName      String?
  profileAvatarCid        String?
  profileAvatarMimeType   String?
  profileUpdatedAt        DateTime?
  timezone                String           @default("UTC")
  timeFormat              String           @default("24h")
  watchCountry            String           @default("US")
  // Reader preference: suppress Spoiler Shields entirely (ADR-0016).
  alwaysShowSpoilers      Boolean          @default(false)
  onboardingCompletedAt   DateTime?
  // One-time AT Store review request state. `atStoreReviewRkey` is allocated
  // before the PDS write so retries use the same record key.
  atStoreReviewHandledAt  DateTime?
  atStoreReviewRkey       String?
  // Welcome Tour seen-state, one version per client (ADR 0024). A value below
  // that client's current tour version replays its whole tour; the two clients
  // are separate because only the mobile tour carries the gestures.
  welcomeTourWebVersion    Int             @default(0)
  welcomeTourMobileVersion Int             @default(0)
  emailVerifiedAt         DateTime?
  // Backfill/sync tracking for the "syncing your watch history…" indicator.
  // backfillStartedAt is stamped when the user's repo is (re-)registered with
  // Tab at sign-in/sign-up; lastIngestAt is bumped each time a watch record is
  // ingested. Together they let the shelf derive whether records are still
  // streaming in — see ShelfService.getSyncStatus.
  backfillStartedAt       DateTime?
  lastIngestAt            DateTime?
  // True only for accounts created on opnshelf's own PDS (native signup).
  // External OAuth accounts are verified upstream, so the email-verification
  // gate must never apply to them — see needsEmailVerification in auth.controller.
  isNativePds             Boolean          @default(false)
  blueskyProfileUrl       String?
  tangledProfileUrl       String?
  showBlueskyOnProfile    Boolean          @default(true)
  showTangledOnProfile    Boolean          @default(true)
  reviewsPublicationUri   String?
  reviewsPublicationName  String?
  // Account-wide integrations. Configuration is retained when disabled so an
  // explicit reconnect can resume the same publication/pointers.
  blogIntegrationEnabled  Boolean          @default(false)
  blueskyCrossPostEnabled Boolean          @default(false)
  // The explicitly confirmed reader format for blog mirrors. This remains
  // markdown until a user selects a supported reader-specific format.
  reviewsMirrorFormat     BlogMirrorFormat @default(markdown)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  trackedMovies   TrackedMovie[]
  trackedEpisodes TrackedEpisode[]
  lists           List[]
  libraryItems    LibraryItem[]
  notes           Note[]
  reviews         Review[]
  publications    Publication[]
  ratings         Rating[]
  reviewLikes     ReviewLike[]
  feedback        Feedback[]
  following       Follow[]         @relation("UserFollowing")
  followers       Follow[]         @relation("UserFollowers")
  circles         Circle[]

  @@index([handle])
  @@index([profileAvatarCid])
}

// Format emitted for a user's site.standard.document blog mirrors.
// The selected value is authoritative; publication inspection can only suggest
// a value in the settings UI (ADR-0014).
enum BlogMirrorFormat {
  markdown
  leaflet
  offprint
  pckt
}

model Follow {
  followerDid  String
  followingDid String
  rkey         String?
  uri          String?
  cid          String?
  createdAt    DateTime @default(now())

  follower      User           @relation("UserFollowing", fields: [followerDid], references: [did], onDelete: Cascade)
  following     User           @relation("UserFollowers", fields: [followingDid], references: [did], onDelete: Cascade)
  circleMembers CircleMember[]

  @@id([followerDid, followingDid])
  @@index([followerDid, createdAt])
  @@index([followingDid, createdAt])
  @@index([followerDid, rkey])
}

// A Circle: a private, personal grouping of Users the owner follows, used to
// filter the activity feed. Local-only — never federated to a PDS (ADR-0010).
model Circle {
  id        String   @id @default(cuid())
  ownerDid  String
  owner     User     @relation(fields: [ownerDid], references: [did], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CircleMember[]

  @@unique([ownerDid, name])
  @@index([ownerDid])
}

// Membership of a followed User in a Circle. Keyed to the Follow row (composite
// FK) so unfollowing cascade-deletes the membership — no orphans. followerDid
// always equals the parent Circle.ownerDid; it is carried only to satisfy the
// composite FK to Follow.
// ponytail: DB doesn't enforce followerDid == Circle.ownerDid; the service sets
// it from the circle owner, so it's controlled in one place.
model CircleMember {
  circleId     String
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  followerDid  String
  followingDid String
  follow       Follow   @relation(fields: [followerDid, followingDid], references: [followerDid, followingDid], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([circleId, followingDid])
  @@index([followingDid])
  @@index([followerDid, followingDid])
}

enum MediaType {
  movie
  show
  season
  episode
}

enum LibraryFormat {
  digital
  bluray
  bluray4k
  dvd
}

// OAuth session storage for @atproto/oauth-client-node sessionStore
// No FK to User because the OAuth library stores session before we create the User
// Cookie stores opaque id (not DID) for session lookup
model AuthSession {
  id          String   @id @default(cuid())
  // Not unique: one row per device session (id is the opaque cookie/Bearer
  // value). A user can be signed in on several devices at once.
  userDid     String
  sessionData String // JSON-serialized session: NodeSavedSession (oauth) or credential tokens (credential)
  kind        String   @default("oauth") // "oauth" | "credential"
  // Which install this session belongs to. Client-supplied (see ADR-0015): the
  // platform vendor id on mobile, a localStorage UUID on web, claimed via the
  // x-opnshelf-device header and stamped by the guard. A grouping and
  // addressing key ONLY — never trusted for authorization. Not null so
  // pre-ADR-0015 rows (backfilled with a random uuid) stay revocable.
  deviceId       String
  // Display label and platform as reported by the client; null until first
  // stamped, which is what the UI shows as "Unknown device".
  deviceName     String?
  devicePlatform String? // "ios" | "android" | "web"
  // Absolute lifetime: the guard rejects the session once expiresAt <= now.
  // Defaults to now() at the DB level so the migration backfills existing rows
  // safely; the app always sets/extends it explicitly (= now + 14d) on write.
  expiresAt   DateTime @default(now())
  // Sliding-refresh marker. Only rewritten when older than a threshold so we
  // don't write to the DB on every authenticated request (see auth.guard.ts).
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@index([expiresAt])
  @@index([userDid])
}

model AuthState {
  key       String   @id
  stateData String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  userDid     String
  status      String    @default("queued")
  data        Json      @default("{}")
  nextRunAt   DateTime  @default(now())
  lastError   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  traktItems   TraktImportItem[]
  traktMatches TraktImportMatch[]

  @@index([type, status, nextRunAt])
  // One trakt_import per User is enforced by the PostgreSQL partial index
  // BackgroundJob_one_trakt_import_per_user_key in migration 20260816120000.
  // Do not replace it with @@unique([userDid, type]); other job types may repeat.
  @@index([userDid, type])
}

// Durable, complete outcome for one source row in a User's single Trakt
// Import. Rows remain for the account lifetime so the result and reconciliation
// queue never imply that an omitted source item was imported.
model TraktImportItem {
  id               String        @id @default(cuid())
  jobId            String
  job              BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceIndex      Int
  outcome          String
  mediaType        String
  watchedAt        DateTime?
  title            String?
  year             Int?
  episodeTitle     String?
  seasonNumber     Int?
  episodeNumber    Int?
  traktMediaKey    String?
  traktId          String?
  traktSlug        String?
  tmdbId           String?
  reason           String?
  message          String?
  createdWatchRkey String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([jobId, sourceIndex])
  @@index([jobId, outcome, sourceIndex])
  @@index([jobId, traktMediaKey])
}

// A User's explicit acceptance that one Trakt media identity should map to a
// TMDB Media Item. It is evidence local to this Import, never an authoritative
// mapping for another User.
model TraktImportMatch {
  id          String        @id @default(cuid())
  jobId       String
  job         BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchKey    String
  mediaType   String
  tmdbId      String
  confirmedAt DateTime      @default(now())

  @@unique([jobId, matchKey])
  @@index([jobId])
}

model Movie {
  movieId      String    @id
  title        String
  posterPath   String?
  backdropPath String?
  releaseYear  Int?
  releaseDate  DateTime?
  overview     String?
  colors       Json? // { primary, secondary, accent, muted }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackedBy    TrackedMovie[]
  listItems    ListItem[]
  libraryItems LibraryItem[]

  @@index([title])
}

model Show {
  showId       String    @id
  title        String
  posterPath   String?
  backdropPath String?
  firstAirYear Int?
  firstAirDate DateTime?
  overview     String?
  colors       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackedBy    TrackedEpisode[]
  listItems    ListItem[]
  libraryItems LibraryItem[]
  seasons      Season[]

  @@index([title])
}

model Season {
  id           String    @id @default(cuid())
  tmdbId       Int       @unique
  showId       String
  show         Show      @relation(fields: [showId], references: [showId], onDelete: Cascade)
  seasonNumber Int
  name         String
  posterPath   String?
  airDate      DateTime?
  episodeCount Int?

  episodes Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seasonNumber])
  @@index([showId])
}

model Episode {
  id            String    @id @default(cuid())
  tmdbId        Int       @unique
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  showId        String
  episodeNumber Int
  seasonNumber  Int
  name          String
  airDate       DateTime?
  overview      String?
  stillPath     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seasonNumber, episodeNumber])
  @@index([seasonId])
  @@index([showId])
  @@index([airDate])
}

model TrackedMovie {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  movieId String
  movie   Movie  @relation(fields: [movieId], references: [movieId], onDelete: Cascade)

  status      String    @default("watched")
  watchedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userDid, rkey], map: "TrackedMovie_userDid_rkey_key")
  @@index([userDid])
  @@index([movieId])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}

model TrackedEpisode {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  showId String
  show   Show   @relation(fields: [showId], references: [showId], onDelete: Cascade)

  seasonNumber  Int
  episodeNumber Int
  status        String    @default("watched")
  watchedDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userDid, rkey], map: "TrackedEpisode_userDid_rkey_key")
  @@index([userDid])
  @@index([showId])
  @@index([seasonNumber])
  @@index([episodeNumber])
  @@index([status])
  @@index([createdAt])
  @@index([watchedDate])
  @@index([uri])
  @@index([cid])
}

model List {
  id   String  @id @default(cuid())
  rkey String
  uri  String
  cid  String?

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  name        String
  description String?
  slug        String
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ListItem[]

  @@unique([userDid, slug])
  @@unique([userDid, rkey], map: "List_userDid_rkey_key")
  @@index([userDid])
  @@index([isDefault])
}

model ListItem {
  id   String  @id @default(cuid())
  rkey String
  uri  String
  cid  String?

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Denormalized repository owner for AT Protocol record identity. Ownership
  // is derived from the parent List when migrating existing rows.
  userDid String

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int       @default(0)
  episodeNumber Int       @default(0)

  movieId String?
  movie   Movie?  @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  showId  String?
  show    Show?   @relation(fields: [showId], references: [showId], onDelete: Cascade)

  notes    String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([listId, mediaType, mediaId, seasonNumber, episodeNumber])
  @@unique([userDid, rkey], map: "ListItem_userDid_rkey_key")
  @@index([userDid])
  @@index([listId])
  @@index([mediaType, mediaId])
}

// A film a user owns in a given Format (their Library). No parent record —
// the Library is an umbrella, not an entity. See ADR 0009.
model LibraryItem {
  id   String  @id @default(cuid())
  rkey String
  uri  String
  cid  String?

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  format        LibraryFormat
  seasonNumber  Int           @default(0)
  episodeNumber Int           @default(0)

  movieId String?
  movie   Movie?  @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  showId  String?
  show    Show?   @relation(fields: [showId], references: [showId], onDelete: Cascade)

  boxSet String?
  notes  String?

  createdAt DateTime @default(now())

  @@unique([userDid, mediaType, mediaId, seasonNumber, episodeNumber, format])
  @@unique([userDid, rkey], map: "LibraryItem_userDid_rkey_key")
  @@index([userDid])
  @@index([mediaType, mediaId])
}

model Note {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int       @default(0)
  episodeNumber Int       @default(0)

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userDid, mediaType, mediaId, seasonNumber, episodeNumber])
  @@unique([userDid, rkey], map: "Note_userDid_rkey_key")
  @@index([userDid])
  @@index([mediaType, mediaId])
}

// A long-form Review, backed by an xyz.opnshelf.review record (ADR-0013).
// A Review carries NO score (the score is a separate Rating, see #112).
// There may be ZERO-or-MANY reviews per user per media item (no unique on the
// media tuple). A Review may OPTIONALLY be mirrored to the author's own
// standard.site blog as a site.standard.document, in which case the mirror's
// AT-URI/CID are stored below.
model Review {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  // Media coordinates.
  mediaType     MediaType
  mediaId       String
  seasonNumber  Int       @default(0)
  episodeNumber Int       @default(0)

  title    String
  // Raw markdown source (the review record's `content`).
  markdown String
  // Author-declared Spoiler Flag (ADR-0016). Whole-review; absent on the
  // record means false. The title is outside the spoiler boundary.
  spoiler  Boolean @default(false)

  // Optional standard.site blog mirror (ADR-0013). Set only when the author has
  // selected a publication and the mirror write succeeded.
  blogDocumentUri String?
  blogDocumentCid String?
  // Per-review opt-out: false excludes this single review from the blog mirror
  // even when the author has a publication configured (mirrors the record's
  // optional `mirrorToBlog`). Defaults to mirror.
  mirrorToBlog    Boolean @default(true)

  // Optional one-time Bluesky Cross-post (ADR-0015). This is only a pointer to
  // the independent post; review edits/deletion never synchronize it.
  blueskyPostUri String?
  blueskyPostCid String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes ReviewLike[]

  @@unique([userDid, rkey], map: "Review_userDid_rkey_key")
  @@index([userDid])
  @@index([mediaType, mediaId])
}

// A site.standard.publication the user owns in their own PDS (e.g. Leaflet).
// opnshelf NO LONGER mints these (ADR-0013); the row is only a firehose-cached
// mirror used to resolve the blog-mirror target the user selected in settings.
model Publication {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  name String
  url  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userDid, rkey], map: "Publication_userDid_rkey_key")
  @@index([userDid])
}

model Rating {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  mediaType     MediaType
  mediaId       String
  seasonNumber  Int       @default(0)
  episodeNumber Int       @default(0)

  rating Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userDid, mediaType, mediaId, seasonNumber, episodeNumber])
  @@unique([userDid, rkey], map: "Rating_userDid_rkey_key")
  @@index([userDid])
  @@index([mediaType, mediaId])
  @@index([rating])
}

model ReviewLike {
  id   String @id @default(cuid())
  rkey String
  uri  String
  cid  String

  userDid String
  user    User   @relation(fields: [userDid], references: [did], onDelete: Cascade)

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userDid, reviewId])
  @@unique([userDid, rkey], map: "ReviewLike_userDid_rkey_key")
  @@index([reviewId])
  @@index([userDid])
}

model Feedback {
  id        String   @id @default(cuid())
  userDid   String
  user      User     @relation(fields: [userDid], references: [did], onDelete: Cascade)
  category  String
  message   String
  pageUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userDid])
  @@index([createdAt])
}
