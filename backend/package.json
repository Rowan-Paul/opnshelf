{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "prebuild": "prisma generate && pnpm run lex:build",
    "railway:build": "prisma generate && nest build",
    "lex:build": "lex build --lexicons ../lexicons --out ./src/lexicons --clear && pnpm format",
    "lex:install": "lex install",
    "openapi:generate": "node -e \"require('ts-node').register({ project: 'tsconfig.json', experimentalResolver: true }); require('./src/generate-openapi.ts')\"",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:apple": "node -e \"require('ts-node').register({ project: 'tsconfig.json', experimentalResolver: true }); require('./scripts/verify-apple-config.ts')\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "env:docs": "ts-node scripts/generate-env-docs.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.18.21",
    "@atproto/common": "^0.5.16",
    "@atproto/identity": "^0.4.12",
    "@atproto/lex": "^0.0.14",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/sync": "^0.1.40",
    "@atproto/tap": "^0.2.15",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jimp": "^1.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2"
}
