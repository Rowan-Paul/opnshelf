{
	"lexicon": 1,
	"id": "app.opnshelf.listItem",
	"defs": {
		"main": {
			"type": "record",
			"description": "A media item in a list for OpnShelf",
			"key": "tid",
			"record": {
				"type": "object",
				"required": ["listRkey", "mediaType", "mediaId", "createdAt"],
				"properties": {
					"listRkey": {
						"type": "string",
						"description": "Rkey of the parent list"
					},
					"mediaType": {
						"type": "string",
						"description": "Media type",
						"enum": ["movie", "show"]
					},
					"mediaId": {
						"type": "string",
						"description": "TMDB media ID"
					},
					"notes": {
						"type": "string",
						"description": "Optional user notes about the media in this list"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "Record creation timestamp"
					}
				}
			}
		}
	}
}
