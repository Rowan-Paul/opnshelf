{
  "name": "opnshelf",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "turbo run build",
    "generate:api": "pnpm --filter @opnshelf/api exec openapi-ts",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "prisma:migrate": "pnpm --filter backend exec prisma migrate dev",
    "check": "turbo run check",
    "check:write": "sh ./scripts/biome-check-write.sh",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.8.14"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
