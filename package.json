{
  "name": "opnshelf",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "turbo run build",
    "generate:api": "pnpm --filter @opnshelf/api exec openapi-ts",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "prisma:migrate": "pnpm --filter backend exec prisma migrate dev",
    "check": "turbo run check",
    "check:write": "turbo run check -- --write --unsafe",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
