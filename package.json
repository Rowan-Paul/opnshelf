{
  "name": "opnshelf",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "turbo run build",
    "generate:api": "pnpm --filter @opnshelf/api exec openapi-typescript http://127.0.0.1:3001/api-json -o src/generated/schema.ts",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "prisma:migrate": "pnpm --filter backend exec prisma migrate dev"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@10.28.2"
}
