{
  "name": "opnshelf",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:backend": "pnpm --filter backend start:dev",
    "build": "turbo run build",
    "generate:api": "pnpm --filter @opnshelf/api exec openapi-ts",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "prisma:migrate": "pnpm --filter backend exec prisma migrate dev",
    "check": "turbo run check",
    "check:write": "turbo run check -- --write --unsafe",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.9.6"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
