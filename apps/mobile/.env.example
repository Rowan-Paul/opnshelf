# Backend API base URL the mobile app talks to.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# PostHog analytics. Leave the key empty to disable analytics in dev.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Turnstile site key for the signup captcha. This is a PUBLIC,
# domain-locked key (the same one the web app uses) — safe to commit. Leave it
# empty for local dev to skip the captcha (the backend also disables
# verification when TURNSTILE_SECRET_KEY is unset).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADYeUs1YOwWNmMY3

# Handle domain new accounts are created on (the PDS host). Defaults to this.
EXPO_PUBLIC_PDS_HANDLE_DOMAIN=opnshelf.social

# Public site origin. Used as the WebView document origin for Turnstile so its
# hostname matches the site key's allowed hostnames. Defaults to this.
EXPO_PUBLIC_SITE_URL=https://opnshelf.xyz
